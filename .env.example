# ==========================================================
# Verifi - Environment Configuration (.env)
# ==========================================================
# Instructions:
# 1. Fill in your API keys below.
# 2. Run `python util/sync_env.py` or double-click `sync_env.bat`.
# 3. Reload the extension in chrome://extensions.
# ==========================================================

# Groq API Key (for fast medical claim extraction)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (for claim verification & Google Search Grounding)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.your_gemini_api_key_here

# Optional Model Configuration
GROQ_MODEL=groq/compound-mini
GEMINI_MODEL=gemini-3.5-flash

# Optional Rate-Limiting & Grounding Settings
ENABLE_SEARCH_GROUNDING=false
PACING_DELAY=6000
BATCH_SIZE=8
