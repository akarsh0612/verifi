{
  "manifest_version": 3,
  "name": "HealthCheck - Medical Claim Fact-Checker",
  "version": "1.0.0",
  "description": "Finds and fact-checks medical and health claims on any webpage using Groq and Gemini with Google Search grounding.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://eutils.ncbi.nlm.nih.gov/*",
    "https://api.semanticscholar.org/*",
    "https://api.crossref.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HealthCheck Fact-Checker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
